# Totality Environment Variables
# Copy this file to .env for local overrides (not committed to git)

# Database backend override (default: auto-detect, prefers better-sqlite3)
# USE_SQLJS=true          # Force SQL.js (WASM) backend
# USE_BETTER_SQLITE3=true # Force better-sqlite3 (native) backend

# Vite dev server URL (set automatically by vite, do not change)
# VITE_DEV_SERVER_URL=http://localhost:5173
